rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.get('role', ''); }
    function isStaff() { return signedIn() && role() in ['superadmin', 'admin', 'ops', 'sales']; }
    function deckEditor() { return signedIn() && role() in ['superadmin', 'admin']; }
    function corpEditor() { return signedIn() && role() in ['superadmin', 'admin', 'sales']; }

    // Zip uploads – processed by the processDeckZip function.
    match /decks/{deckId}/uploads/{file} {
      allow read: if isStaff();
      allow create: if deckEditor() && file.matches('.*\\.zip')
        && request.resource.size < 500 * 1024 * 1024;
    }

    // Processed art – written by functions only; readable by app users (future) and staff.
    match /decks/{deckId}/art/{rest=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /fonts/{file} {
      allow read: if signedIn();
      allow create: if deckEditor() && request.resource.size < 10 * 1024 * 1024
        && file.matches('.*\\.(ttf|otf|woff|woff2)');
    }

    // Corporate design files and proofs.
    match /corporates/{corpId}/{rest=**} {
      allow read: if isStaff();
      allow create: if corpEditor() && request.resource.size < 200 * 1024 * 1024;
      allow delete: if corpEditor();
    }

    // Invoice PDFs – generated by issueInvoice.
    match /invoices/{file} {
      allow read: if signedIn() && role() in ['superadmin', 'admin', 'sales'];
      allow write: if false;
    }

    match /{rest=**} {
      allow read, write: if false;
    }
  }
}
