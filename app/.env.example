# Copy to .env.local (same Firebase web app config as the admin dashboard)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_APP_ID=
# Must match REGION in functions/src/common.ts
VITE_FUNCTIONS_REGION=asia-southeast1
# true = talk to the local emulators instead of the real project
VITE_USE_EMULATORS=false
