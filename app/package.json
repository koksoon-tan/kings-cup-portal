{
  "name": "kings-cup-play",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator --port 5174 --strictPort",
    "dev:demo": "vite --mode demo --port 5174 --strictPort",
    "build": "tsc -p . --noEmit && vite build",
    "build:demo": "vite build --mode demo",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only hosting:play"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/rye": "^5.3.0",
    "firebase": "^12.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "buffer": "^6.0.3",
    "jszip": "^3.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
